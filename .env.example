# Server
PORT=3000
NODE_ENV=development

# PostgreSQL - Required
DATABASE_URL=postgresql://user:password@localhost:5432/vin_research

# Anthropic Claude AI - Required for AI summaries
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Marketcheck API - Optional, enables live market listings and pricing
# Free tier available at: https://www.marketcheck.com/api
MARKETCHECK_API_KEY=your_marketcheck_key_here

# Unsplash API - Optional, enables vehicle photo gallery
# Free tier (50 req/hr) at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_key_here
